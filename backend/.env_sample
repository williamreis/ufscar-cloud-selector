# ===========================================
# LLM Configuration (multi-provedor)
# ===========================================

# Define qual provedor de LLM usar: "openai" | "groq" | "openrouter" | "gemini" | "ollama"
# Todos exceto "openai" têm camada gratuita (ou são 100% locais, no caso do ollama).
LLM_PROVIDER=groq

# --- OpenAI (pago) ---
OPENAI_API_KEY=coloque_sua_chave_aqui
OPENAI_MODEL=gpt-4o-mini

# --- Groq (gratuito, sem cartão de crédito, inferência muito rápida) ---
# console.groq.com -> API Keys. Modelos grátis atuais: openai/gpt-oss-120b,
# openai/gpt-oss-20b, llama-3.3-70b-versatile (verificar deprecations em
# console.groq.com/docs/deprecations antes de usar em produção)
GROQ_API_KEY=coloque_sua_chave_aqui
GROQ_MODEL=openai/gpt-oss-120b

# --- OpenRouter (gratuito, agrega dezenas de modelos ":free" via 1 API key) ---
# openrouter.ai/keys. Lista de modelos grátis muda com frequência:
# https://openrouter.ai/models?max_price=0
OPENROUTER_API_KEY=coloque_sua_chave_aqui
OPENROUTER_MODEL=meta-llama/llama-4-maverick:free

# --- Google Gemini (gratuito, bom limite diário de requisições) ---
# aistudio.google.com/apikey
GEMINI_API_KEY=coloque_sua_chave_aqui
GEMINI_MODEL=gemini-2.5-flash

# --- Ollama (100% gratuito e local, requer servidor Ollama rodando) ---
# https://ollama.com — ex.: `ollama run llama3.1`
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1

# Opcional: sobrepõe o modelo do provedor escolhido acima. Sem isso vale a
# variável específica do provedor (OPENAI_MODEL, GROQ_MODEL, ...).
# LLM_MODEL=
# LLM_TEMPERATURE=0.2
# LLM_MAX_TOKENS=1500

# ===========================================
# Embeddings (independentes do LLM)
# ===========================================

# "openai" ou "huggingface" (sentence-transformers, roda local e sem chave).
# Sem definir, segue a regra anterior: openai quando LLM_PROVIDER=openai,
# huggingface nos demais casos.
# EMBEDDING_PROVIDER=huggingface

# ATENÇÃO: trocar o modelo de embedding muda a dimensão dos vetores e invalida o
# índice FAISS já gerado. Depois de trocar, refaça a ingestão.
# Padrões: openai -> text-embedding-ada-002 · huggingface -> all-MiniLM-L6-v2
# EMBEDDING_MODEL=

# Chave usada só pelos embeddings. Sem isso, cai em OPENAI_API_KEY.
# EMBEDDING_API_KEY=

# Caminho de persistência do índice vetorial (FAISS)
VECTOR_DB_PATH=../data/faiss_index

# Nome da coleção (mantido por compatibilidade; não usado pelo FAISS)
VECTOR_COLLECTION_NAME=providers_docs

# Porta e host do backend
API_HOST=0.0.0.0
API_PORT=8000

# Tamanho padrão dos chunks e sobreposição (em tokens)
CHUNK_SIZE=1000
CHUNK_OVERLAP=200

# Quantos trechos cada consulta ao RAG devolve
MAX_CHUNKS_PER_QUERY=5

# ===========================================
# Guardrails de entrada (diretriz §23.2)
# ===========================================

# Limite por resposta dissertativa. Acima disso o envio é recusado com motivo —
# truncar em silêncio faria a avaliação rodar sobre metade do que foi escrito.
MAX_OPEN_TEXT_CHARS=4000

# Limite de tamanho por arquivo enviado e de documentos por sessão
MAX_UPLOAD_MB=20
MAX_DOCUMENTS_PER_EVALUATION=20

# Extensões aceitas no upload e na ingestão
ALLOWED_UPLOAD_EXTENSIONS=.pdf,.txt

# O que fazer ao encontrar credencial em texto ou documento: MASK, REJECT ou WARN.
# MASK remove o segredo e segue; REJECT recusa o envio; WARN só registra.
GUARDRAIL_SECRET_ACTION=MASK

# ===========================================
# Versionamento (diretriz §28)
# ===========================================

# Versão declarada do questionário. O hash do conteúdo é calculado sozinho.
QUESTIONNAIRE_VERSION=1

# Versão da regra de pontuação. Toda mudança metodológica pede uma versão nova.
SCORING_ALGORITHM_VERSION=1

# Onde o backend lê o questions.json para calcular o hash da versão. No
# docker-compose isto já vem definido; localmente o padrão aponta para
# frontend/public/questions.json.
# QUESTIONS_JSON_PATH=

# ===========================================
# Configuração metodológica (diretriz §39)
# ===========================================

# Indicadores (id, dimensão, tipo, direção, rubrica, termos de busca) e escalas
# (coeficientes de relevância, rubricas padrão, método do AHP, desempate).
# Padrão: backend/methodology/. O hash dos dois arquivos entra na versão de cada
# avaliação — editá-los muda a versão, não o passado.
# INDICATORS_PATH=
# METHODOLOGY_SCALES_PATH=

# ===========================================
# Pontos em aberto na dissertação (diretriz §45)
# ===========================================

# TODO ACADÊMICO 04 — limiar de atualidade documental, em meses. Sem valor, o
# alerta fica desligado: a diretriz proíbe assumir 24 meses como regra sem
# confirmação acadêmica.
# EVIDENCE_STALE_MONTHS=

# TODO ACADÊMICO 05 — deltas da análise de sensibilidade. Default técnico e
# provisório, não uma decisão metodológica.
# SENSITIVITY_DELTAS=-0.10,-0.05,0.05,0.10

# ===========================================
# Area de gestao / auditoria
# ===========================================

# Senha do painel /admin. Enquanto estiver vazia, a area de gestao responde 503.
# Defina um valor e reinicie o backend. Trocar a senha invalida os tokens ja emitidos.
ADMIN_PASSWORD=

# Opcional: segredo proprio para assinar o token. Sem isso, deriva da senha acima.
# ADMIN_TOKEN_SECRET=

# Opcional: validade do token em segundos (padrao 8h).
# ADMIN_TOKEN_TTL=28800

# Banco de auditoria (SQLite). Fica em backend/data/, que ja e volume persistente.
AUDIT_DB_PATH=../data/audit.db
