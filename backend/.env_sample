# ===========================================
# LLM Configuration (OpenAI / Groq)
# ===========================================

# Define qual provedor de LLM usar: "openai" ou "groq"
LLM_PROVIDER=openai

# Chave da OpenAI
OPENAI_API_KEY=coloque_sua_chave_aqui

# Chave da Groq (se usar o Groq API)
GROQ_API_KEY=coloque_sua_chave_aqui

# Caminho de persistência do banco vetorial (Chroma)
VECTOR_DB_PATH=./chroma_db

# Nome da coleção utilizada no ChromaDB
VECTOR_COLLECTION_NAME=providers_docs

# Porta e host do backend
API_HOST=0.0.0.0
API_PORT=8000

# Modelos padrão
OPENAI_MODEL=gpt-4o-mini
GROQ_MODEL=llama-3.1-70b-versatile

# Tamanho padrão dos chunks e sobreposição (em tokens)
CHUNK_SIZE=1000
CHUNK_OVERLAP=200
